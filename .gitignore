# ---- Model weights and datasets ----
# Licensed separately by MPI-IS and never committed. Download SMPL / SMPL-X
# weights from https://smpl-x.is.tue.mpg.de/ into data/ (see README).
data/
smpl_models/
datasets/
# Safety net so licensed weights cannot be committed from an unexpected path.
# Force-add with `git add -f` if you ever need to track a small fixture.
*.pkl
*.npz

# ---- Run artifacts ----
benchmarks/logs/
*.log
*.bak

# ---- Third-party build trees ----
third_party/*/build/
third_party/*/dist/
